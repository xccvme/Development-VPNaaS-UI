package views

import "vpnaas/ui-goth/internal/model"

// ---------- shared form pieces ----------
templ Modal(title string) {
	@modalBox(title, "max-w-lg") {
		{ children... }
	}
}

// ModalWide is used by wide forms and configuration modals (Site S2S, Configure).
templ ModalWide(title string) {
	@modalBox(title, "max-w-4xl") {
		{ children... }
	}
}

templ modalBox(title, width string) {
	<div class="fixed inset-0 z-50 flex items-start justify-center overflow-y-auto bg-[#212529]/40 px-4 py-10" data-modal>
		<div class={ "w-full rounded-xl bg-white shadow-2xl", width } role="dialog" aria-modal="true" aria-label={ title }>
			<div class="flex items-center justify-between border-b border-[#DEE2E6] px-6 py-4">
				<h2 class="text-lg font-bold">{ title }</h2>
				<button type="button" class="rounded-md px-2 text-2xl leading-none text-[#6C757D] hover:bg-[#F1F3F5]" data-modal-close aria-label="Tutup">×</button>
			</div>
			<div class="px-6 py-5">
				{ children... }
			</div>
		</div>
	</div>
}

templ field(label, name, value, typ, errMsg, hint string, required bool) {
	<label class="block text-sm font-semibold text-[#212529]">
		{ label }
		if typ == "password" {
			<input
				type="password"
				name={ name }
				autocomplete="new-password"
				placeholder={ hint }
				if required {
					required
				}
				class={ inputClass(errMsg) }
			/>
		} else {
			<input
				type={ typ }
				name={ name }
				value={ value }
				if required {
					required
				}
				class={ inputClass(errMsg) }
			/>
			if hint != "" {
				<span class="mt-1 block text-xs font-normal text-[#6C757D]">{ hint }</span>
			}
		}
		if errMsg != "" {
			<span class="mt-1 block text-xs font-normal text-[#B3261E]">{ errMsg }</span>
		}
	</label>
}

// cidrList is a textarea for one-or-more CIDRs (one per line or comma
// separated); the form layer joins them with commas for the backend.
templ cidrList(label, name, value, placeholder, errMsg, hint string, required bool) {
	@cidrListMax(label, name, value, placeholder, errMsg, hint, required, 8)
}

templ cidrListMax(label, name, value, placeholder, errMsg, hint string, required bool, max int) {
	<label class="block text-sm font-semibold text-[#212529]">
		{ label }
		<textarea
			name={ name }
			rows="2"
			placeholder={ placeholder }
			spellcheck="false"
			autocomplete="off"
			data-cidr-list
			data-cidr-max={ itoa(max) }
			if required {
				required
			}
			class={ inputClass(errMsg) + " font-mono text-sm" }
		>{ value }</textarea>
		if hint != "" {
			<span class="mt-1 block text-xs font-normal text-[#6C757D]">{ hint }</span>
		}
		if errMsg != "" {
			<span class="mt-1 block text-xs font-normal text-[#B3261E]">{ errMsg }</span>
		}
	</label>
}

func inputClass(err string) string {
	if err != "" {
		return "mt-1 w-full rounded-md border border-[#DC3545] px-3 py-2 font-normal focus:outline-none focus:ring-2 focus:ring-[#DC3545]/20"
	}
	return "mt-1 w-full rounded-md border border-[#CED4DA] px-3 py-2 font-normal focus:border-[#2F6BC4] focus:outline-none focus:ring-2 focus:ring-[#2F6BC4]/20"
}

templ textInput(label, name, value, placeholder, errMsg, hint string, required bool) {
	<label class="block text-sm font-semibold text-[#212529]">
		{ label }
		<input
			type="text"
			name={ name }
			value={ value }
			placeholder={ placeholder }
			autocomplete="off"
			spellcheck="false"
			if required {
				required
			}
			class={ inputClass(errMsg) }
		/>
		if hint != "" {
			<span class="mt-1 block text-xs font-normal text-[#6C757D]">{ hint }</span>
		}
		if errMsg != "" {
			<span class="mt-1 block text-xs font-normal text-[#B3261E]">{ errMsg }</span>
		}
	</label>
}

templ enabledBox(on bool) {
	<label class="flex items-center gap-2 text-sm font-semibold">
		<input type="checkbox" name="enabled" checked?={ on } class="h-4 w-4 accent-[#2F6BC4]"/>
		Enabled
	</label>
}

templ formFooter(submit string) {
	<div class="flex justify-end gap-2 border-t border-[#DEE2E6] pt-4">
		<button type="button" data-modal-close class="rounded-full border border-[#CED4DA] px-5 py-2 text-sm font-semibold hover:bg-[#F8F9FA]">Cancel</button>
		<button type="submit" class="rounded-full bg-[#2F6BC4] px-5 py-2 text-sm font-semibold text-white hover:bg-[#2559A8]">{ submit }</button>
	</div>
}

templ ConfirmModal(c Confirm) {
	@Modal(c.Title) {
		@ErrorBox(c.Err)
		<p class="text-sm text-[#495057]">{ c.Message }</p>
		<p class="mt-2 rounded-md bg-[#F8F9FA] px-3 py-2 font-mono text-sm">{ c.Name }</p>
		<div class="mt-5 flex justify-end gap-2">
			<button type="button" data-modal-close class="rounded-full border border-[#CED4DA] px-5 py-2 text-sm font-semibold hover:bg-[#F8F9FA]">Cancel</button>
			if c.Button == "Disconnect" || c.Method == "post" {
				<button type="button" hx-post={ c.URL } hx-target={ ternary(c.Target != "", c.Target, "#sites-table") } hx-swap="outerHTML" class="rounded-full bg-[#DC3545] px-5 py-2 text-sm font-semibold text-white hover:bg-[#B02A37]">{ c.Button }</button>
			} else {
				<button type="button" hx-delete={ c.URL } hx-target="#modal" class="rounded-full bg-[#DC3545] px-5 py-2 text-sm font-semibold text-white hover:bg-[#B02A37]">{ c.Button }</button>
			}
		</div>
	}
}

templ tableHead(count, total int, url, target, q, placeholder string) {
	<div class="flex flex-col gap-3 border-b border-[#DEE2E6] px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
		<div class="text-sm text-[#6C757D]">{ itoa(count) } dari { itoa(total) } data</div>
		<div class="flex items-center gap-2">
			@SearchBox(url, target, q, placeholder)
			@RefreshButton(target, url)
		</div>
	</div>
}

templ emptyOrNoMatch(total int, hasErr bool, title, detail string) {
	if total > 0 {
		@Empty("Tidak ada data yang cocok", "Coba kata kunci lain.")
	} else if !hasErr {
		@Empty(title, detail)
	}
}

// ---------- Akun C2S ----------
templ UsersPage(t UserTable) {
	@PageHeader("Client-to-Site (C2S)", "Kelola akses remote client IPsec/IKEv2 ke VPC/NAT server, site S2S tertentu, atau seluruh site yang ada.", PrimaryButton("Create Account", "/akun/baru"))
	@VPNTabs("akun")
	@UsersTable(t)
}

templ UsersTable(t UserTable) {
	<section id="users-table" class="rounded-xl border border-[#DEE2E6]" hx-get="/akun/tabel" hx-trigger="every 30s, vpnaas:changed from:body" hx-swap="outerHTML" hx-include="this" hx-disinherit="*">
		@tableHead(len(t.Rows), t.Total, "/akun/tabel", "#users-table", t.Query, "Search account…")
		<div class="px-5 pt-4 empty:hidden">
			@FlashBox(t.Flash)
			@ErrorBox(t.Err)
			if t.Stale {
				@ErrorBox("Menampilkan data terakhir; status runtime tidak dapat diverifikasi sehingga ditandai Unknown.")
			}
		</div>
		if len(t.Rows) == 0 {
			@emptyOrNoMatch(t.Total, t.Err != "", "Belum ada akun C2S", "Buat akun C2S pertama untuk akses ke VPC server atau site S2S.")
		} else {
			<div class="overflow-x-auto pb-1" tabindex="0" aria-label="Tabel dapat digeser horizontal">
				<table class="min-w-full text-sm">
					<thead class="bg-[#E9ECEF]">
						<tr>
							@th("Username")
							@th("Access Target (VPC / Site / CIDR)")
							@th("Admin")
							@th("Status & Last Connect")
							@th("Sessions")
							@th("Virtual IP")
							@th("Actions")
						</tr>
					</thead>
					<tbody>
						for _, u := range t.Rows {
							<tr class="border-t border-[#DEE2E6] hover:bg-[#F8F9FA]">
								<td class="whitespace-nowrap px-3 py-3">
									<span class="flex items-center gap-2 font-semibold text-[#2F6BC4]">
										@Dot(u.OnlineLabel())
										{ u.Username }
									</span>
									<span class="text-xs text-[#6C757D]">
										ID { itoa(u.ID) } · <span class="rounded bg-[#E8EEF9] px-2 py-0.5 font-semibold text-[#2F6BC4]">{ u.TrafficLabel() }</span>
										if u.AuthMethod != "" && u.AuthMethod != "eap-mschapv2" {
											· @Badge(u.AuthLabel())
										}
									</span>
								</td>
								<td class="px-3 py-3 font-mono text-xs">
									<div class="flex flex-wrap gap-1 font-sans">
										if u.AllowVPC {
											@Badge("VPC")
										}
										if u.AllowAllSites {
											@Badge("All Sites")
										}
										for _, sn := range namesFromIDs(u.AllowedSites, t.SiteNames) {
											<span class="rounded bg-[#E8EEF9] px-2 py-0.5 text-xs font-semibold text-[#2F6BC4]">Site: { sn }</span>
										}
										for _, gn := range namesFromIDs(u.Groups, t.GroupNames) {
											<span class="rounded bg-[#EDE7F6] px-2 py-0.5 text-xs font-semibold text-[#5E35B1]">Group: { gn }</span>
										}
									</div>
									<div class="mt-1 text-[#495057]">{ model.Join(u.DisplayCIDRs()) }</div>
								</td>
								<td class="px-3 py-3">
									@Badge(u.AdminLabel())
								</td>
								<td class="px-3 py-3 text-xs">
									@Badge(u.OnlineLabel())
									<div class="mt-1 text-[#6C757D]">{ u.LastConnectDisplay() }</div>
								</td>
								<td class="px-3 py-3">
									<div class="flex items-center gap-3">
										<span>{ u.SessionLabel() }</span>
										@rowBtn("Detail", "get", idURL("/akun", u.ID, "/sesi"), "#modal", false)
									</div>
								</td>
								<td class="px-3 py-3 font-mono">{ model.Join(u.VirtualIPs) }</td>
								<td class="px-3 py-3">
									@accountActions(u)
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
}

templ UserSessions(u model.User, errMsg string) {
	@Modal("Session Detail") {
		@ErrorBox(errMsg)
		if errMsg == "" {
			<p class="mb-4 text-sm font-semibold">{ u.Username } · ID { itoa(u.ID) } · { u.OnlineLabel() } · Sesi { u.SessionLabel() }</p>
			if len(u.Sessions) == 0 {
				<p class="text-sm text-[#6C757D]">Tidak ada sesi aktif. Last connect: { u.LastConnectDisplay() }</p>
			}
			<div class="max-h-96 space-y-3 overflow-y-auto">
				for _, s := range u.Sessions {
					<div class="rounded-lg bg-[#F8F9FA] p-3 font-mono text-xs break-words">
						<div class="flex items-center justify-between gap-2">
							<div>IKE #{ s.IKEID } · { s.IKEState }</div>
							if s.IKEID != "" {
								<button type="button" hx-post={ "/akun/" + itoa(u.ID) + "/sesi/" + s.IKEID + "/disconnect" } hx-target="#modal" class="rounded-full border border-[#F5C2C7] px-2.5 py-0.5 font-sans text-xs font-semibold text-[#B3261E] hover:bg-[#FDECEA]">Disconnect</button>
							}
						</div>
						<div>from { s.RemoteAddress }</div>
						<div>VIP { model.Join(s.VirtualIPs) }</div>
						for _, c := range s.Children {
							<div class="mt-2">CHILD #{ c.ChildID } · { c.State } · in { model.Bytes(c.BytesIn) } · out { model.Bytes(c.BytesOut) }</div>
						}
					</div>
				}
			</div>
		}
		<div class="mt-5 flex justify-end border-t border-[#DEE2E6] pt-4">
			<button type="button" data-modal-close class="rounded-full border border-[#CED4DA] px-5 py-2 text-sm font-semibold hover:bg-[#F8F9FA]">Close</button>
		</div>
	}
}

templ UserForm(f Form) {
	@Modal(ternary(f.Edit(), "Edit Account", "Create Account")) {
		<form
			if f.Edit() {
				hx-put={ idURL("/akun", f.ID, "") }
			} else {
				hx-post="/akun"
			}
			hx-target="#modal"
			class="space-y-4"
		>
			@ErrorBox(f.Err)
			@field("Username", "username", f.V("username"), "text", f.E("username"), "", true)
			if !f.Edit() {
				@field("Password", "password", "", "password", f.E("password"), ternary(hasCertType(f.Certs, "user"), "Wajib untuk EAP-MSCHAPv2 (kosongkan jika pakai X.509/EAP-TLS)", "Password baru (8-128 karakter), tidak pernah ditampilkan lagi"), !hasCertType(f.Certs, "user"))
			} else {
				@field("Password", "password", "", "password", f.E("password"), "Kosongkan untuk mempertahankan password lama", false)
			}
			<fieldset class="space-y-3 rounded-lg border border-[#DEE2E6] p-3">
				<legend class="px-1 text-sm font-semibold">Tujuan Akses Client (Konek ke Mana)</legend>
				<div>
					<input type="hidden" name="allow_vpc_present" value="1"/>
					<input type="hidden" name="vpc_cidr" value={ f.VPCDisplay() }/>
					<input type="hidden" name="allow_vpc" value="0"/>
					<label class="flex items-center gap-2 text-sm font-semibold">
						<input type="checkbox" name="allow_vpc" value="on" checked?={ f.V("allow_vpc") == "on" } class="h-4 w-4 accent-[#2F6BC4]"/>
						<span>VPC / NAT Server Gateway (<span class="font-mono text-xs text-[#2F6BC4]">{ f.VPCDisplay() }</span>)</span>
					</label>
					<span class="mt-1 block pl-6 text-xs font-normal text-[#6C757D]">Izinkan client mengakses jaringan VPC dan static route lokal yang tersambung ke server VPN ini.</span>
				</div>
				<div>
					<input type="hidden" name="allow_all_sites_present" value="1"/>
					<input type="hidden" name="allow_all_sites" value="0"/>
					<label class="flex items-center gap-2 text-sm font-semibold">
						<input type="checkbox" name="allow_all_sites" value="on" checked?={ f.V("allow_all_sites") == "on" } class="h-4 w-4 accent-[#2F6BC4]"/>
						<span>Semua Site S2S yang ada (otomatis ikut site baru)</span>
					</label>
					<span class="mt-1 block pl-6 text-xs font-normal text-[#6C757D]">Centang bersama VPC di atas agar client bisa mengakses seluruh site S2S dan VPC sekaligus.</span>
				</div>
				<div class="border-t border-[#DEE2E6] pt-4">
					<div class="text-sm font-semibold text-[#212529]">Atau Pilih Site S2S Tertentu</div>
					<input type="hidden" name="allowed_sites_present" value="1"/>
					if len(f.Sites) == 0 {
						<p class="mt-1 rounded-md bg-[#E8EEF9] px-3 py-2 text-xs text-[#2C3E87]">Belum ada Site S2S terdaftar. Client ini dapat langsung terhubung ke VPC / NAT server gateway.</p>
					} else {
						<div class="mt-2 space-y-2">
							for _, st := range f.Sites {
								<label class="flex flex-wrap items-center gap-2 text-sm">
									<input type="checkbox" name="allowed_sites" value={ itoa(st.ID) } checked?={ f.Checked("allowed_sites", st.ID) } class="h-4 w-4 accent-[#2F6BC4]"/>
									<span class="font-semibold">{ st.Name }</span>
									<span class="font-mono text-xs text-[#6C757D]">({ model.Join(st.EffectiveSubnetList()) })</span>
									@Badge(st.OnlineLabel())
								</label>
							}
						</div>
						<p class="mt-1 text-xs text-[#6C757D]">Client akan mendapat akses ke subnet &amp; NAT di belakang site yang dipilih.</p>
					}
				</div>
				<label class="block text-sm font-semibold">
					Allowed CIDRs Tambahan (opsional)
					<textarea name="allowed_cidrs" rows="2" placeholder="10.10.7.0/24" class={ inputClass(f.E("allowed_cidrs")) + " font-mono" }>{ f.V("allowed_cidrs") }</textarea>
					<span class="mt-1 block text-xs font-normal text-[#6C757D]">Opsional — subnet kustom tambahan (satu CIDR per baris/koma).</span>
					if f.E("allowed_cidrs") != "" {
						<span class="mt-1 block text-xs font-normal text-[#B3261E]">{ f.E("allowed_cidrs") }</span>
					}
				</label>
			</fieldset>
			if len(f.Groups) > 0 {
				<fieldset class="space-y-2 rounded-lg border border-[#DEE2E6] p-3">
					<legend class="px-1 text-sm font-semibold">C2S Groups (opsional)</legend>
					<input type="hidden" name="groups_present" value="1"/>
					<div class="flex flex-wrap gap-3">
						for _, g := range f.Groups {
							<label class="flex items-center gap-2 text-sm">
								<input type="checkbox" name="groups" value={ itoa(g.ID) } checked?={ f.Checked("groups", g.ID) } class="h-4 w-4 accent-[#2F6BC4]"/>
								<span>{ g.Name }</span>
							</label>
						}
					</div>
				</fieldset>
			}
			if hasCertType(f.Certs, "user") || (f.V("auth_method") != "" && f.V("auth_method") != "eap-mschapv2") || f.E("cert_id") != "" || f.E("auth_method") != "" {
				<fieldset class="space-y-2 rounded-lg border border-[#DEE2E6] p-3">
					<legend class="px-1 text-sm font-semibold">Authentication Method</legend>
					<select name="auth_method" class={ inputClass(f.E("auth_method")) }>
						<option value="eap-mschapv2" selected?={ f.V("auth_method") == "" || f.V("auth_method") == "eap-mschapv2" }>EAP-MSCHAPv2 (Username &amp; Password)</option>
						<option value="pubkey" selected?={ f.V("auth_method") == "pubkey" }>X.509 Certificate (Mutual Certificate)</option>
						<option value="eap-tls" selected?={ f.V("auth_method") == "eap-tls" }>EAP-TLS (Client Certificate)</option>
					</select>
					if f.E("auth_method") != "" {
						<span class="mt-1 block text-xs font-normal text-[#B3261E]">{ f.E("auth_method") }</span>
					}
					<label class="block text-xs font-semibold text-[#495057]">
						Client Certificate (untuk X.509 / EAP-TLS)
						<select name="cert_id" class={ inputClass(f.E("cert_id")) }>
							<option value="">— Tanpa sertifikat client —</option>
							for _, cert := range f.Certs {
								if cert.TargetType == "user" && !cert.Revoked {
									<option value={ itoa(cert.ID) } selected?={ f.V("cert_id") == itoa(cert.ID) }>{ cert.Name } ({ cert.SAN })</option>
								}
							}
						</select>
						if f.E("cert_id") != "" {
							<span class="mt-1 block text-xs font-normal text-[#B3261E]">{ f.E("cert_id") }</span>
						}
					</label>
				</fieldset>
			}
			@trafficMode(f)
			@maxSessions(f)
			@enabledBox(f.Enabled)
			@formFooter(ternary(f.Edit(), "Save", "Create"))
		</form>
	}
}

templ maxSessions(f Form) {
	<label class="block text-sm font-semibold">
		Max Concurrent Sessions
		<select name="max_sessions" class={ inputClass(f.E("max_sessions")) }>
			for _, n := range []string{"1", "2", "3"} {
				<option value={ n } selected?={ maxSessionsValue(f) == n }>{ n }</option>
			}
		</select>
		<span class="mt-1 block text-xs font-normal text-[#6C757D]">Jumlah perangkat yang boleh terhubung bersamaan dengan akun ini (1–3, default 3).</span>
		if f.E("max_sessions") != "" {
			<span class="mt-1 block text-xs font-normal text-[#B3261E]">{ f.E("max_sessions") }</span>
		}
	</label>
}

templ trafficMode(f Form) {
	<fieldset class="space-y-2 rounded-lg border border-[#DEE2E6] p-3">
		<legend class="px-1 text-sm font-semibold">Traffic Mode</legend>
		<select name="traffic_mode" aria-label="Traffic Mode" class={ inputClass(f.E("traffic_mode")) }>
			<option value="split" selected?={ f.V("traffic_mode") != "full" }>Split tunnel (default)</option>
			<option value="full" selected?={ f.V("traffic_mode") == "full" }>Full tunnel</option>
		</select>
		<p class="text-xs text-[#6C757D]">Split: hanya jaringan diizinkan lewat VPN (default). Full: semua internet lewat server; akses LAN tetap dibatasi tujuan akses di atas. Unduh ulang profil / Setup Windows lalu sambungkan ulang setelah mengubah mode.</p>
		if f.E("traffic_mode") != "" {
			<p class="text-xs text-[#B3261E]">{ f.E("traffic_mode") }</p>
		}
	</fieldset>
}

// rowActions is the shared row action menu across all VPNaaS tables: a plain
// vertical three-dot toggle; options live in a manual popover that app.js
// opens on click only and closes on outside click, Escape or selection.
templ rowActions(menuID, name string) {
	<div data-row-actions>
		<button type="button" data-actions-toggle aria-label={ "Actions for " + name } aria-haspopup="menu" aria-expanded="false" aria-controls={ menuID } class="kebab-button">
			<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><circle cx="12" cy="5" r="1.8"></circle><circle cx="12" cy="12" r="1.8"></circle><circle cx="12" cy="19" r="1.8"></circle></svg>
		</button>
		<div id={ menuID } class="action-menu" role="menu" aria-label={ "Actions " + name } popover="manual">
			{ children... }
		</div>
	</div>
}

templ accountActions(u model.User) {
	@rowActions("account-menu-"+itoa(u.ID), u.Username) {
		<button type="button" role="menuitem" hx-get={ idURL("/akun", u.ID, "/configure") } hx-target="#modal">Detail Account</button>
		<a role="menuitem" href={ templ.URL(idURL("/unduh/akun", u.ID, "/manual.conf")) } download>Manual Config (.conf)</a>
		<a role="menuitem" href={ templ.URL(idURL("/unduh/akun", u.ID, "/profil.json")) } download title="Profil berisi kredensial; simpan dengan aman">VPN Profile (.json)</a>
		<a role="menuitem" href={ templ.URL(idURL("/unduh/akun", u.ID, "/vpnaas-ca.crt")) } download>Download Cert (.crt)</a>
		<button type="button" role="menuitem" hx-post={ idURL("/akun", u.ID, "/disconnect") } hx-target="#users-table" hx-swap="outerHTML">Disconnect</button>
		<button type="button" role="menuitem" class="menu-danger" hx-get={ idURL("/akun", u.ID, "/hapus") } hx-target="#modal">Delete</button>
	}
}

templ UserConfigureModal(d UserConfigureData) {
	@ModalWide("Detail Account: " + d.User.Username) {
		@ErrorBox(d.Err)
		if d.Err == "" {
			<div class="space-y-4 text-sm">
				<div class="flex flex-wrap items-center justify-between gap-2">
					<div class="flex flex-wrap items-center gap-2">
						<span class="font-semibold">{ d.User.Username }</span>
						@Badge(d.User.OnlineLabel())
						@Badge(d.User.AuthLabel())
						@Badge("FIPS IKEv2")
					</div>
					<div class="flex flex-wrap items-center gap-2">
						<button type="button" hx-get={ idURL("/akun", d.User.ID, "/ubah") } hx-target="#modal" class="rounded-full bg-[#2F6BC4] px-4 py-2 text-xs font-semibold text-white hover:bg-[#2559A8]">Edit Account</button>
						<button type="button" hx-get={ idURL("/akun", d.User.ID, "/password") } hx-target="#modal" class="rounded-full border border-[#CED4DA] px-4 py-2 text-xs font-semibold text-[#212529] hover:bg-[#F8F9FA]">Reset Password</button>
					</div>
				</div>
				<div class="rounded-lg bg-[#F8F9FA] p-4 font-mono text-xs space-y-1">
					<div><strong>Server Gateway (Remote Addr &amp; ID):</strong> { ternary(d.HubPublicIP != "", d.HubPublicIP, "—") } · UDP 500 &amp; 4500</div>
					<div><strong>Username / Auth:</strong> { d.User.Username } · { d.User.AuthLabel() }</div>
					<div><strong>Virtual IP:</strong> { ternary(d.User.VirtualIP != "", d.User.VirtualIP, "—") } · <strong>Traffic Mode:</strong> { d.User.TrafficLabel() }</div>
					<div><strong>Crypto FIPS:</strong> IKE aes256-sha256-modp2048 (DH14) · ESP aes256-sha256</div>
					<div class="mt-1 flex flex-wrap items-center gap-1">
						<strong>Access Target:</strong>
						if d.User.AllowVPC {
							@Badge("VPC")
						}
						if d.User.AllowAllSites {
							@Badge("All Sites")
						}
						for _, sn := range namesFromIDs(d.User.AllowedSites, d.SiteNames) {
							<span class="rounded bg-[#E8EEF9] px-2 py-0.5 text-xs font-semibold text-[#2F6BC4]">Site: { sn }</span>
						}
						for _, gn := range namesFromIDs(d.User.Groups, d.GroupNames) {
							<span class="rounded bg-[#EDE7F6] px-2 py-0.5 text-xs font-semibold text-[#5E35B1]">Group: { gn }</span>
						}
					</div>
					<div><strong>Allowed Subnets:</strong> { model.Join(d.User.DisplayCIDRs()) }</div>
					<div><strong>Last Connect:</strong> { d.User.LastConnectDisplay() }</div>
					if d.Cert != nil {
						<div><strong>Client Certificate:</strong> { d.Cert.Name } (SAN: { d.Cert.SAN } · Serial #{ d.Cert.Serial })</div>
					}
				</div>
				<div>
					<div class="mb-2 text-xs font-semibold text-[#495057]">Download Client Profile &amp; Config</div>
					<div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
						<a href={ templ.URL(idURL("/unduh/akun", d.User.ID, "/manual.conf")) } download class="rounded-lg bg-[#2F6BC4] px-3 py-2.5 text-center font-semibold text-white hover:bg-[#2559A8]">Manual Config (.conf)</a>
						<a href={ templ.URL(idURL("/unduh/akun", d.User.ID, "/profil.json")) } download class="rounded-lg border border-[#CED4DA] px-3 py-2.5 text-center font-semibold text-[#212529] hover:bg-[#F8F9FA]">VPN Profile (.json)</a>
					</div>
				</div>
				<div class="rounded-lg border border-[#DEE2E6] p-3">
					<div class="mb-2 text-xs font-semibold text-[#495057]">X.509 Certificates (Root CA &amp; Client Cert)</div>
					<div class="flex flex-wrap gap-2">
						<a href={ templ.URL(idURL("/unduh/akun", d.User.ID, "/vpnaas-ca.crt")) } download class="rounded-full border border-[#CED4DA] px-3 py-1 text-xs font-semibold text-[#2F6BC4] hover:bg-[#E8EEF9]">Download Cert (.crt)</a>
						if d.User.CertID != nil {
							<a href={ templ.URL("/unduh/pki/certs/" + itoa(*d.User.CertID) + "/cert.crt") } download class="rounded-full border border-[#1A73E8] px-3 py-1 text-xs font-semibold text-[#2F6BC4] hover:bg-[#E8EEF9]">Client Cert (.crt)</a>
							<a href={ templ.URL("/unduh/pki/certs/" + itoa(*d.User.CertID) + "/key.key") } download class="rounded-full border border-[#1A73E8] px-3 py-1 text-xs font-semibold text-[#2F6BC4] hover:bg-[#E8EEF9]">Private Key (.key)</a>
							<a href={ templ.URL("/unduh/pki/certs/" + itoa(*d.User.CertID) + "/bundle.p12") } download class="rounded-full border border-[#1A73E8] px-3 py-1 text-xs font-semibold text-[#2F6BC4] hover:bg-[#E8EEF9]">Cert + Key Bundle (.p12)</a>
						}
					</div>
				</div>
			</div>
		}
		<div class="mt-5 flex justify-end border-t border-[#DEE2E6] pt-4">
			<button type="button" data-modal-close class="rounded-full border border-[#CED4DA] px-5 py-2 text-sm font-semibold hover:bg-[#F8F9FA]">Close</button>
		</div>
	}
}

templ PasswordForm(id int, username, errMsg, fieldErr string) {
	@Modal("Reset Password") {
		<form hx-put={ idURL("/akun", id, "/password") } hx-target="#modal" class="space-y-4">
			@ErrorBox(errMsg)
			<input type="hidden" name="username" value={ username }/>
			<p class="text-sm text-[#495057]">Atur password baru untuk <span class="font-mono font-semibold">{ username }</span>. Sesi aktif akun ini akan diputus oleh backend. Password tidak pernah ditampilkan kembali.</p>
			@field("Password baru", "password", "", "password", fieldErr, "8-128 karakter", true)
			@formFooter("Reset Password")
		</form>
	}
}

// ---------- Firewall Rules (/kebijakan) ----------
templ PoliciesPage(t PolicyTable) {
	@PageHeader("Firewall Rules", "Allow/Deny rule tambahan untuk traffic antar jaringan (S2S/LAN/C2S). Default: deny. Akses user C2S tetap diatur dari Allowed CIDRs akun.", PrimaryButton("Create Rule", "/kebijakan/baru"))
	@VPNTabs("kebijakan")
	@PoliciesTable(t)
}

templ PoliciesTable(t PolicyTable) {
	<section id="policies-table" class="rounded-xl border border-[#DEE2E6]" hx-get="/kebijakan/tabel" hx-trigger="vpnaas:changed from:body" hx-swap="outerHTML" hx-include="this" hx-disinherit="*">
		@tableHead(len(t.Rows), t.Total, "/kebijakan/tabel", "#policies-table", t.Query, "Search rule…")
		<div class="px-5 pt-4 empty:hidden">
			@FlashBox(t.Flash)
			@ErrorBox(t.Err)
		</div>
		if len(t.Rows) == 0 {
			@emptyOrNoMatch(t.Total, t.Err != "", "Belum ada firewall rule", "Buat rule untuk mengizinkan atau memblokir traffic antar CIDR / site.")
		} else {
			<div class="overflow-x-auto pb-1" tabindex="0" aria-label="Tabel dapat digeser horizontal">
				<table class="min-w-full text-sm">
					<thead class="bg-[#E9ECEF]">
						<tr>
							@th("Name")
							@th("Source")
							@th("Destination")
							@th("Protocol")
							@th("Status")
							@th("Actions")
						</tr>
					</thead>
					<tbody>
						for _, p := range t.Rows {
							<tr class="border-t border-[#DEE2E6] hover:bg-[#F8F9FA]">
								<td class="whitespace-nowrap px-3 py-3">
									<div class="font-semibold text-[#2F6BC4]">{ p.Name }</div>
									<div class="mt-1 flex items-center gap-1 text-xs text-[#6C757D]">
										@Badge(p.ActionLabel())
										if p.Priority > 0 {
											<span>Prio { itoa(p.Priority) }</span>
										}
									</div>
								</td>
								<td class="px-3 py-3 font-mono text-xs">{ p.SourceDisplay(t.SiteNames, t.UserNames, t.GroupNames) }</td>
								<td class="px-3 py-3 font-mono text-xs">{ p.DestDisplay(t.SiteNames) }</td>
								<td class="px-3 py-3 font-mono text-xs">
									{ upper(p.Protocol) }
									if p.Ports != "" {
										<span>:{ p.Ports }</span>
									}
								</td>
								<td class="px-3 py-3">
									@Badge(p.AdminLabel())
								</td>
								<td class="px-3 py-3">
									@rowActions("policy-menu-"+itoa(p.ID), p.Name) {
										<button type="button" role="menuitem" hx-get={ idURL("/kebijakan", p.ID, "/ubah") } hx-target="#modal">Edit</button>
										<button type="button" role="menuitem" class="menu-danger" hx-get={ idURL("/kebijakan", p.ID, "/hapus") } hx-target="#modal">Delete</button>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
}

templ PolicyForm(f Form) {
	@Modal(ternary(f.Edit(), "Edit Firewall Rule", "Create Firewall Rule")) {
		<form
			if f.Edit() {
				hx-put={ idURL("/kebijakan", f.ID, "") }
			} else {
				hx-post="/kebijakan"
			}
			hx-target="#modal"
			class="space-y-4"
		>
			@ErrorBox(f.Err)
			@field("Rule Name", "name", f.V("name"), "text", f.E("name"), "", true)
			<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
				<label class="block text-sm font-semibold">
					Action
					<select name="action" class={ inputClass(f.E("action")) }>
						<option value="allow" selected?={ f.V("action") != "deny" }>ALLOW (Izinkan)</option>
						<option value="deny" selected?={ f.V("action") == "deny" }>DENY (Blokir)</option>
					</select>
					if f.E("action") != "" {
						<span class="mt-1 block text-xs font-normal text-[#B3261E]">{ f.E("action") }</span>
					}
				</label>
				@field("Priority (1–10000)", "priority", ternary(f.V("priority") != "", f.V("priority"), "100"), "text", f.E("priority"), "Angka kecil dievaluasi duluan", false)
			</div>
			<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
				<label class="block text-sm font-semibold">
					Source Type
					<select name="source_type" class={ inputClass(f.E("source_type")) }>
						<option value="cidr" selected?={ f.V("source_type") == "" || f.V("source_type") == "cidr" }>CIDR Manual</option>
						<option value="site" selected?={ f.V("source_type") == "site" }>Multi-Site S2S</option>
						<option value="user" selected?={ f.V("source_type") == "user" }>User C2S</option>
						<option value="group" selected?={ f.V("source_type") == "group" }>Group C2S</option>
					</select>
					if f.E("source_type") != "" {
						<span class="mt-1 block text-xs font-normal text-[#B3261E]">{ f.E("source_type") }</span>
					}
				</label>
				<label class="block text-sm font-semibold">
					Source Entity (bila bukan CIDR)
					<select name="source_ref" class={ inputClass(f.E("source_ref")) }>
						<option value="">— Pilih jika tipe Site/User/Group —</option>
						for _, st := range f.Sites {
							<option value={ itoa(st.ID) } selected?={ f.V("source_type") == "site" && f.V("source_ref") == itoa(st.ID) }>[Site] { st.Name }</option>
						}
						for _, u := range f.Users {
							<option value={ itoa(u.ID) } selected?={ f.V("source_type") == "user" && f.V("source_ref") == itoa(u.ID) }>[User] { u.Username }</option>
						}
						for _, g := range f.Groups {
							<option value={ itoa(g.ID) } selected?={ f.V("source_type") == "group" && f.V("source_ref") == itoa(g.ID) }>[Group] { g.Name }</option>
						}
					</select>
					if f.E("source_ref") != "" {
						<span class="mt-1 block text-xs font-normal text-[#B3261E]">{ f.E("source_ref") }</span>
					}
				</label>
			</div>
			@field("Source CIDR", "source_cidr", f.V("source_cidr"), "text", f.E("source_cidr"), "Jaringan asal traffic, mis. 10.1.0.0/24 (LAN site lawan)", false)
			<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
				<label class="block text-sm font-semibold">
					Destination Type
					<select name="destination_type" class={ inputClass(f.E("destination_type")) }>
						<option value="cidr" selected?={ f.V("destination_type") == "" || f.V("destination_type") == "cidr" }>CIDR Manual</option>
						<option value="site" selected?={ f.V("destination_type") == "site" }>Multi-Site S2S</option>
						<option value="vpc" selected?={ f.V("destination_type") == "vpc" }>VPC / LAN Server</option>
					</select>
					if f.E("destination_type") != "" {
						<span class="mt-1 block text-xs font-normal text-[#B3261E]">{ f.E("destination_type") }</span>
					}
				</label>
				<label class="block text-sm font-semibold">
					Destination Site (bila tipe Site)
					<select name="destination_ref" class={ inputClass(f.E("destination_ref")) }>
						<option value="">— Pilih site tujuan —</option>
						for _, st := range f.Sites {
							<option value={ itoa(st.ID) } selected?={ f.V("destination_type") == "site" && f.V("destination_ref") == itoa(st.ID) }>[Site] { st.Name }</option>
						}
					</select>
					if f.E("destination_ref") != "" {
						<span class="mt-1 block text-xs font-normal text-[#B3261E]">{ f.E("destination_ref") }</span>
					}
				</label>
			</div>
			@field("Destination CIDR", "destination_cidr", f.V("destination_cidr"), "text", f.E("destination_cidr"), "Jaringan tujuan traffic, mis. 10.10.7.0/24 (LAN server ini). Hanya arah source → destination yang diizinkan.", false)
			<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
				<label class="block text-sm font-semibold">
					Protocol
					<select name="protocol" class={ inputClass(f.E("protocol")) }>
						for _, p := range []string{"all", "tcp", "udp", "icmp"} {
							<option value={ p } selected?={ f.V("protocol") == p }>{ upper(p) }</option>
						}
					</select>
					if f.E("protocol") != "" {
						<span class="mt-1 block text-xs font-normal text-[#B3261E]">{ f.E("protocol") }</span>
					}
				</label>
				@field("Ports (opsional, TCP/UDP)", "ports", f.V("ports"), "text", f.E("ports"), "mis. 443 atau 80,443,8000-8080", false)
			</div>
			@enabledBox(f.Enabled)
			@formFooter(ternary(f.Edit(), "Save", "Create"))
		</form>
	}
}
