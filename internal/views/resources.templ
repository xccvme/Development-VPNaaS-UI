package views

import "vpnaas/ui-goth/internal/model"

// ---------- shared form pieces ----------
templ Modal(title string) {
	@modalBox(title, "max-w-lg") {
		{ children... }
	}
}

// ModalWide is used by the VPN Hub form (two site cards side by side).
templ ModalWide(title string) {
	@modalBox(title, "max-w-4xl") {
		{ children... }
	}
}

templ modalBox(title, width string) {
	<div class="fixed inset-0 z-50 flex items-start justify-center overflow-y-auto bg-[#212529]/40 px-4 py-10" data-modal>
		<div class={ "w-full rounded-xl bg-white shadow-2xl", width } role="dialog" aria-modal="true" aria-label={ title }>
			<div class="flex items-center justify-between border-b border-[#DEE2E6] px-6 py-4">
				<h2 class="text-lg font-bold">{ title }</h2>
				<button type="button" class="rounded-md px-2 text-2xl leading-none text-[#6C757D] hover:bg-[#F1F3F5]" data-modal-close aria-label="Tutup">×</button>
			</div>
			<div class="px-6 py-5">
				{ children... }
			</div>
		</div>
	</div>
}

templ field(label, name, value, typ, errMsg, hint string, required bool) {
	<label class="block text-sm font-semibold text-[#212529]">
		{ label }
		if typ == "password" {
			<input
				type="password"
				name={ name }
				autocomplete="new-password"
				placeholder={ hint }
				if required {
					required
				}
				class={ inputClass(errMsg) }
			/>
		} else {
			<input
				type={ typ }
				name={ name }
				value={ value }
				if required {
					required
				}
				class={ inputClass(errMsg) }
			/>
			if hint != "" {
				<span class="mt-1 block text-xs font-normal text-[#6C757D]">{ hint }</span>
			}
		}
		if errMsg != "" {
			<span class="mt-1 block text-xs font-normal text-[#B3261E]">{ errMsg }</span>
		}
	</label>
}

// cidrList is a textarea for one-or-more CIDRs (one per line or comma
// separated); the form layer joins them with commas for the backend.
templ cidrList(label, name, value, placeholder, errMsg, hint string, required bool) {
	<label class="block text-sm font-semibold text-[#212529]">
		{ label }
		<textarea
			name={ name }
			rows="2"
			placeholder={ placeholder }
			spellcheck="false"
			autocomplete="off"
			data-cidr-list
			if required {
				required
			}
			class={ inputClass(errMsg) + " font-mono text-sm" }
		>{ value }</textarea>
		if hint != "" {
			<span class="mt-1 block text-xs font-normal text-[#6C757D]">{ hint }</span>
		}
		if errMsg != "" {
			<span class="mt-1 block text-xs font-normal text-[#B3261E]">{ errMsg }</span>
		}
	</label>
}

templ subnetCell(local, remote []string) {
	<td class="px-3 py-3 font-mono text-xs" data-subnets>
		<div class="flex min-w-[220px] max-w-[360px] items-start gap-2">
			<div class="flex flex-wrap gap-x-2">
				for _, l := range local {
					<span>{ l }</span>
				}
			</div>
			<span class="text-[#6C757D]" aria-label="ke">↔</span>
			<div class="flex flex-wrap gap-x-2">
				for _, r := range remote {
					<span>{ r }</span>
				}
			</div>
		</div>
	</td>
}

func inputClass(err string) string {
	if err != "" {
		return "mt-1 w-full rounded-md border border-[#DC3545] px-3 py-2 font-normal focus:outline-none focus:ring-2 focus:ring-[#DC3545]/20"
	}
	return "mt-1 w-full rounded-md border border-[#CED4DA] px-3 py-2 font-normal focus:border-[#2F6BC4] focus:outline-none focus:ring-2 focus:ring-[#2F6BC4]/20"
}

templ enabledBox(on bool) {
	<label class="flex items-center gap-2 text-sm font-semibold">
		<input type="checkbox" name="enabled" checked?={ on } class="h-4 w-4 accent-[#2F6BC4]"/>
		Enabled (administratif)
	</label>
}

templ formFooter(submit string) {
	<div class="flex justify-end gap-2 border-t border-[#DEE2E6] pt-4">
		<button type="button" data-modal-close class="rounded-full border border-[#CED4DA] px-5 py-2 text-sm font-semibold hover:bg-[#F8F9FA]">Batal</button>
		<button type="submit" class="rounded-full bg-[#2F6BC4] px-5 py-2 text-sm font-semibold text-white hover:bg-[#2559A8]">{ submit }</button>
	</div>
}

templ ConfirmModal(c Confirm) {
	@Modal(c.Title) {
		@ErrorBox(c.Err)
		<p class="text-sm text-[#495057]">{ c.Message }</p>
		<p class="mt-2 rounded-md bg-[#F8F9FA] px-3 py-2 font-mono text-sm">{ c.Name }</p>
		<div class="mt-5 flex justify-end gap-2">
			<button type="button" data-modal-close class="rounded-full border border-[#CED4DA] px-5 py-2 text-sm font-semibold hover:bg-[#F8F9FA]">Batal</button>
			if c.Button == "Disconnect" {
				<button type="button" hx-post={ c.URL } hx-target="#conn-table" hx-swap="outerHTML" class="rounded-full bg-[#DC3545] px-5 py-2 text-sm font-semibold text-white hover:bg-[#B02A37]">{ c.Button }</button>
			} else {
				<button type="button" hx-delete={ c.URL } hx-target="#modal" class="rounded-full bg-[#DC3545] px-5 py-2 text-sm font-semibold text-white hover:bg-[#B02A37]">{ c.Button }</button>
			}
		</div>
	}
}

templ tableHead(count, total int, url, target, q, placeholder string) {
	<div class="flex flex-col gap-3 border-b border-[#DEE2E6] px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
		<div class="text-sm text-[#6C757D]">{ itoa(count) } dari { itoa(total) } data</div>
		<div class="flex items-center gap-2">
			@SearchBox(url, target, q, placeholder)
			@RefreshButton(target, url)
		</div>
	</div>
}

templ emptyOrNoMatch(total int, hasErr bool, title, detail string) {
	if total > 0 {
		@Empty("Tidak ada data yang cocok", "Coba kata kunci lain.")
	} else if !hasErr {
		@Empty(title, detail)
	}
}

// ---------- VPN Hub (/koneksi) ----------
templ ConnectionsPage(t ConnTable) {
	@PageHeader("VPN Hub", "Hubungkan LAN antar site lewat server ini sebagai hub: Site-A ⇄ Hub ⇄ Site-B. Client di Site-A bisa ping/akses Site-B dan sebaliknya.", PrimaryButton("Buat VPN Hub", "/koneksi/baru"))
	@VPNTabs("koneksi")
	@hubDiagram()
	@s2sRoutingInfo()
	@ConnectionsTable(t)
}

// hubDiagram is a compact flex sketch of the hub-and-spoke topology.
templ hubDiagram() {
	<div class="mb-4 flex flex-wrap items-center gap-2 rounded-lg border border-[#DEE2E6] bg-white px-4 py-3 text-sm" data-hub-diagram aria-label="Topologi: Site-A ke Hub, Site-B ke Hub">
		<span class="rounded-md border border-[#CED4DA] bg-[#F8F9FA] px-3 py-1 font-semibold">Site-A <span class="font-normal text-[#6C757D]">(LAN)</span></span>
		<span class="font-mono text-[#6C757D]" aria-hidden="true">──IPsec──▶</span>
		<span class="rounded-md bg-[#2F6BC4] px-3 py-1 font-semibold text-white">Hub <span class="font-normal text-white/80">(server ini)</span></span>
		<span class="font-mono text-[#6C757D]" aria-hidden="true">◀──IPsec──</span>
		<span class="rounded-md border border-[#CED4DA] bg-[#F8F9FA] px-3 py-1 font-semibold">Site-B <span class="font-normal text-[#6C757D]">(LAN)</span></span>
		<span class="basis-full text-xs text-[#6C757D] sm:basis-auto sm:pl-2">Tiap site cukup konek ke hub; trafik Site-A ⇄ Site-B diteruskan oleh hub.</span>
	</div>
}

templ s2sRoutingInfo() {
	<details class="mb-4 rounded-lg border border-[#DEE2E6] bg-[#F8F9FA] px-4 py-2 text-sm text-[#495057]" data-s2s-info>
		<summary class="cursor-pointer select-none font-semibold text-[#2F6BC4]">Site Active tapi host LAN tidak bisa saling ping?</summary>
		<ul class="mt-2 list-disc space-y-1 pl-5">
			<li>Gateway tiap site harus mengaktifkan IP forwarding dan menjadi jalur LAN ke subnet site lawan: host/router LAN butuh route ke subnet site lawan via LAN IP gateway site (atau jadikan gateway tersebut default gateway).</li>
			<li>Opsi NAT/masquerade di tiap site membuat host LAN tidak perlu route balik; matikan jika router LAN sudah punya route ke site lawan dan Anda ingin melihat IP asli.</li>
			<li>OpenStack: tambahkan subnet site lawan ke allowed-address-pairs port LAN gateway, atau nonaktifkan port security di port tersebut; jika tidak, paket di-drop oleh anti-spoofing.</li>
			<li>Koneksi Direct (lama) tetap memakai aturan menu Firewall Rules.</li>
		</ul>
		<p class="mt-2 text-xs text-[#6C757D]">Detail: dokumentasi/jaringan.md (backend).</p>
	</details>
}

templ ConnectionsTable(t ConnTable) {
	<section id="conn-table" class="rounded-xl border border-[#DEE2E6]" hx-get="/koneksi/tabel" hx-trigger="every 30s, vpnaas:changed from:body" hx-swap="outerHTML" hx-include="this" hx-disinherit="*">
		@tableHead(len(t.Rows), t.Total, "/koneksi/tabel", "#conn-table", t.Query, "Cari VPN Hub / site / subnet…")
		<div class="px-5 pt-4 empty:hidden">
			@FlashBox(t.Flash)
			@ErrorBox(t.Err)
			if t.StatusErr != "" && len(t.DirectRows()) > 0 {
				@ErrorBox("Status runtime koneksi Direct (lama) tidak tersedia (ditampilkan Unknown): " + t.StatusErr)
			}
		</div>
		if len(t.Rows) == 0 {
			@emptyOrNoMatch(t.Total, t.Err != "", "Belum ada VPN Hub", "Klik Buat VPN Hub untuk menghubungkan LAN Site-A dan Site-B lewat server ini.")
		} else {
			if len(t.HubRows()) > 0 {
				@hubTable(t.HubRows())
			}
			if len(t.DirectRows()) > 0 {
				@directTable(t.DirectRows())
			}
		}
	</section>
}

templ hubTable(rows []ConnRow) {
	<div class="overflow-x-auto pb-1" tabindex="0" aria-label="Tabel dapat digeser horizontal">
		<table class="min-w-full text-sm" data-hub-table>
			<thead class="bg-[#E9ECEF]">
				<tr>
					@th("Nama")
					@th("Site-A")
					@th("Site-B")
					@th("Aksi")
				</tr>
			</thead>
			<tbody>
				for _, c := range rows {
					<tr class="border-t border-[#DEE2E6] align-top hover:bg-[#F8F9FA]">
						<td class="whitespace-nowrap px-3 py-3">
							<span class="flex items-center gap-2 font-semibold text-[#2F6BC4]">
								@Dot(c.Runtime)
								{ c.Name }
							</span>
							<span class="mt-1 flex items-center gap-1 text-xs text-[#6C757D]">
								ID { itoa(c.ID) }
								@Badge(c.AdminLabel())
							</span>
						</td>
						@siteCell(c.A())
						@siteCell(c.B())
						<td class="px-3 py-3">
							@hubActions(c)
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ siteCell(s model.Site) {
	<td class="px-3 py-3" data-site>
		<div class="min-w-[200px] max-w-[320px] space-y-1">
			<div class="flex items-center gap-2">
				<span class="font-semibold">{ s.Name }</span>
				@Badge(s.StatusLabel())
			</div>
			<div class="flex flex-wrap gap-x-2 font-mono text-xs">
				for _, n := range s.SubnetList() {
					<span>{ n }</span>
				}
			</div>
			<div class="text-xs text-[#6C757D]">
				if s.RemoteHost != "" {
					Remote host: <span class="font-mono">{ s.RemoteHost }</span>
				} else if s.BehindNAT() {
					Alamat: <span class="font-mono">%any</span> (di belakang NAT)
				} else {
					Alamat: <span class="font-mono">{ s.Address }</span>
				}
				· NAT { ternary(s.NATOn(), "on", "off") }
			</div>
			if s.BytesIn != nil || s.BytesOut != nil {
				<div class="font-mono text-xs text-[#6C757D]">in { model.Bytes(s.BytesIn) } · out { model.Bytes(s.BytesOut) }</div>
			}
		</div>
	</td>
}

templ directTable(rows []ConnRow) {
	<section class="border-t border-[#DEE2E6]" data-direct-legacy>
		<div class="flex items-center gap-2 px-5 pt-4 text-sm font-semibold text-[#495057]">
			@Badge("Direct (lama)")
			<span>Koneksi S2S langsung (format lama) — tetap berjalan seperti sebelumnya.</span>
		</div>
		<div class="overflow-x-auto pb-1" tabindex="0" aria-label="Tabel dapat digeser horizontal">
			<table class="mt-2 min-w-full text-sm">
				<thead class="bg-[#E9ECEF]">
					<tr>
						@th("Nama Koneksi")
						@th("Alamat Remote")
						@th("Remote ID")
						@th("Subnet (lokal ↔ remote)")
						@th("Admin")
						@th("Runtime")
						@th("Aksi")
					</tr>
				</thead>
				<tbody>
					for _, c := range rows {
						<tr class="border-t border-[#DEE2E6] hover:bg-[#F8F9FA]">
							<td class="whitespace-nowrap px-3 py-3">
								<span class="flex items-center gap-2 font-semibold text-[#2F6BC4]">
									@Dot(c.Runtime)
									{ c.Name }
								</span>
								@Badge(c.TopologyLabel())
							</td>
							<td class="px-3 py-3 font-mono">{ c.RemoteAddress }</td>
							<td class="px-3 py-3 font-mono">{ c.RemoteID }</td>
							@subnetCell(c.LocalList(), c.RemoteList())
							<td class="px-3 py-3">
								@Badge(c.AdminLabel())
							</td>
							<td class="px-3 py-3">
								@Badge(c.Runtime)
							</td>
							<td class="px-3 py-3">
								@connectionActions(c)
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</section>
}

templ textInput(label, name, value, placeholder, errMsg, hint string, required bool) {
	<label class="block text-sm font-semibold text-[#212529]">
		{ label }
		<input
			type="text"
			name={ name }
			value={ value }
			placeholder={ placeholder }
			autocomplete="off"
			spellcheck="false"
			if required {
				required
			}
			class={ inputClass(errMsg) }
		/>
		if hint != "" {
			<span class="mt-1 block text-xs font-normal text-[#6C757D]">{ hint }</span>
		}
		if errMsg != "" {
			<span class="mt-1 block text-xs font-normal text-[#B3261E]">{ errMsg }</span>
		}
	</label>
}

templ HubForm(f Form) {
	@ModalWide(ternary(f.Edit(), "Ubah VPN Hub", "Buat VPN Hub")) {
		<form
			if f.Edit() {
				hx-put={ idURL("/koneksi", f.ID, "") }
			} else {
				hx-post="/koneksi"
			}
			hx-target="#modal"
			class="space-y-4"
		>
			@ErrorBox(f.Err)
			<input type="hidden" name="topology" value="hub"/>
			@textInput("Nama VPN Hub", "name", f.V("name"), "mis. kantor-cabang", f.E("name"), "Huruf, angka, _ @ . : - (dipakai di nama file script).", true)
			<p class="rounded-md bg-[#E8EEF9] px-3 py-2 text-xs text-[#2C3E87]">Site-A dan Site-B masing-masing konek ke server ini (hub). Isi subnet LAN di belakang tiap site; hub meneruskan trafik antar keduanya.</p>
			<div class="grid grid-cols-1 gap-4 md:grid-cols-2">
				@siteCard(f, "a")
				@siteCard(f, "b")
			</div>
			@enabledBox(f.Enabled)
			if !f.Edit() {
				<p class="text-xs text-[#6C757D]">Perlu tunnel langsung server ini ↔ satu peer (format lama)? <button type="button" class="font-semibold text-[#1A73E8] underline" hx-get="/koneksi/baru?topology=direct" hx-target="#modal">Koneksi Direct (lama)</button></p>
			}
			@formFooter(ternary(f.Edit(), "Simpan", "Buat"))
		</form>
	}
}

templ siteCard(f Form, key string) {
	<fieldset class="space-y-3 rounded-lg border border-[#DEE2E6] p-4" data-site-card={ key }>
		<legend class="px-1 text-base font-bold text-[#2F6BC4]">{ siteLabel(key) }</legend>
		@textInput("Nama site", "site_"+key+"_name", f.V("site_"+key+"_name"), ternary(key == "a", "mis. jakarta", "mis. surabaya"), f.E("site_"+key+"_name"), "", true)
		@textInput("Alamat publik", "site_"+key+"_address", f.V("site_"+key+"_address"), "IP publik/hostname, kosongkan jika di belakang NAT", f.E("site_"+key+"_address"), "Kosong = %any (site yang memulai koneksi ke hub).", false)
		@textInput("IKE ID (opsional)", "site_"+key+"_id", f.V("site_"+key+"_id"), "otomatis (<nama>-"+key+"@vpnaas)", f.E("site_"+key+"_id"), "", false)
		@field("PSK (opsional)", "site_"+key+"_psk", "", "password", f.E("site_"+key+"_psk"), ternary(f.Edit(), "kosongkan = tidak diubah", "kosongkan = generate otomatis"), false)
		@cidrList("Subnet LAN", "site_"+key+"_subnets", f.V("site_"+key+"_subnets"), ternary(key == "a", "192.168.10.0/24", "192.168.20.0/24"), f.E("site_"+key+"_subnets"), "LAN di belakang site ini yang boleh diakses site lawan. Satu CIDR per baris atau koma (maks. 8).", true)
		<div>
			<input type="hidden" name={ "site_" + key + "_nat" } value="0"/>
			<label class="flex items-center gap-2 text-sm font-semibold">
				<input type="checkbox" name={ "site_" + key + "_nat" } value="on" checked?={ f.V("site_"+key+"_nat") == "on" } class="h-4 w-4 accent-[#2F6BC4]"/>
				NAT / masquerade
			</label>
			<span class="mt-1 block pl-6 text-xs text-[#6C757D]">Aktifkan jika router LAN tidak punya route balik ke site lawan</span>
		</div>
	</fieldset>
}

templ HubConfigure(h HubSite) {
	@Modal("Configure " + h.Label()) {
		@ErrorBox(h.Err)
		if h.Err == "" {
			<p class="text-sm text-[#495057]">
				VPN Hub <span class="font-mono font-semibold">{ h.Name }</span> · { h.Label() } <span class="font-semibold">{ h.Site.Name }</span> · status
				@Badge(h.Site.StatusLabel())
			</p>
			<ol class="mt-4 list-decimal space-y-3 pl-5 text-sm text-[#212529]">
				<li>
					Download Setup script:
					<a href={ templ.URL(h.ScriptURL()) } download class="font-semibold text-[#1A73E8] underline">{ h.ScriptFile() }</a>
					<span class="block text-xs text-[#6C757D]">Script berisi PSK site ini; simpan dengan aman. Alternatif manual: <a href={ templ.URL(h.ConfURL()) } download class="text-[#1A73E8] underline">{ h.ConfFile() }</a> (swanctl.conf).</span>
				</li>
				<li>Copy ke gateway { h.Label() } (Linux, mis. router/VM di LAN site tersebut): <code class="block rounded bg-[#F8F9FA] px-2 py-1 font-mono text-xs">{ "scp " + h.ScriptFile() + " root@<gateway-" + h.Label() + ">:" }</code></li>
				<li>Jalankan di gateway: <code class="block rounded bg-[#F8F9FA] px-2 py-1 font-mono text-xs">{ "sudo bash " + h.ScriptFile() }</code></li>
				<li>Tunggu status { h.Label() } di tabel menjadi <span class="font-semibold">Active</span> (tabel refresh tiap 30 detik, atau klik Muat ulang).</li>
			</ol>
			<div class="mt-4 space-y-1 rounded-md bg-[#FFF4E5] px-3 py-2 text-xs text-[#5C3B00]">
				<p>Gateway { h.Label() } harus mengaktifkan IP forwarding (net.ipv4.ip_forward=1) dan berada di jalur LAN: host LAN perlu route ke subnet { h.Peer() } via LAN IP gateway ini (atau gateway ini jadi default gateway).</p>
				<p>NAT/masquerade untuk { h.Label() }: <span class="font-semibold">{ ternary(h.Site.NATOn(), "aktif", "nonaktif") }</span>. Aktifkan (menu Ubah) jika router LAN tidak punya route balik ke { h.Peer() }.</p>
				if h.Site.BehindNAT() {
					<p>Alamat site = %any (di belakang NAT): koneksi dimulai dari gateway site, jadi Connect dari hub tidak tersedia untuk site ini.</p>
				}
			</div>
		}
		<div class="mt-5 flex justify-end border-t border-[#DEE2E6] pt-4">
			<button type="button" data-modal-close class="rounded-full border border-[#CED4DA] px-5 py-2 text-sm font-semibold hover:bg-[#F8F9FA]">Tutup</button>
		</div>
	}
}

templ ConnectionForm(f Form) {
	@Modal(ternary(f.Edit(), "Ubah Koneksi", "Koneksi Direct (lama)")) {
		<p class="mb-3 flex items-center gap-2">
			@Badge("Direct (lama)")
			<span class="text-xs text-[#6C757D]">Koneksi S2S langsung server ini ↔ satu peer (format lama).</span>
		</p>
		<form
			if f.Edit() {
				hx-put={ idURL("/koneksi", f.ID, "") }
			} else {
				hx-post="/koneksi"
			}
			hx-target="#modal"
			class="space-y-4"
		>
			@ErrorBox(f.Err)
			@field("Nama koneksi", "name", f.V("name"), "text", f.E("name"), "", true)
			@field("Alamat remote (IPv4)", "remote_address", f.V("remote_address"), "text", f.E("remote_address"), "", true)
			@field("Remote ID (opsional)", "remote_id", f.V("remote_id"), "text", f.E("remote_id"), "Identitas IKE peer (IP atau FQDN). Kosong = sama dengan alamat remote.", false)
			<p class="rounded-md bg-[#E8EEF9] px-3 py-2 text-xs text-[#2C3E87]">Isi subnet yang boleh saling akses lewat tunnel. Di site lawan isinya dibalik.</p>
			@cidrList("Subnet LAN lokal (server ini)", "local_ts", f.V("local_ts"), "10.10.7.0/24", f.E("local_ts"), ternary(f.Edit(), "Satu CIDR per baris atau pisahkan koma (maks. 8). Kosong = tidak diubah.", "Satu CIDR per baris atau pisahkan koma (maks. 8). Kosong = LAN default server."), false)
			@cidrList("Subnet LAN remote (site lawan)", "remote_ts", f.V("remote_ts"), "10.1.0.0/24\n10.2.0.0/24", f.E("remote_ts"), "Satu CIDR per baris atau pisahkan koma (maks. 8).", true)
			@field("PSK (pre-shared key)", "psk", "", "password", f.E("psk"), ternary(f.Edit(), "Kosongkan untuk mempertahankan PSK lama", "Kunci rahasia yang sama di kedua site (8-128 karakter)"), !f.Edit())
			@enabledBox(f.Enabled)
			@formFooter(ternary(f.Edit(), "Simpan", "Buat"))
		</form>
	}
}

// ---------- Akun C2S ----------
templ UsersPage(t UserTable) {
	@PageHeader("Akun Client-to-Site", "Kelola identitas remote access, izin jaringan, dan profil klien.", PrimaryButton("Buat Akun", "/akun/baru"))
	@VPNTabs("akun")
	@UsersTable(t)
}

templ UsersTable(t UserTable) {
	<section id="users-table" class="rounded-xl border border-[#DEE2E6]" hx-get="/akun/tabel" hx-trigger="every 30s, vpnaas:changed from:body" hx-swap="outerHTML" hx-include="this" hx-disinherit="*">
		@tableHead(len(t.Rows), t.Total, "/akun/tabel", "#users-table", t.Query, "Cari akun…")
		<div class="px-5 pt-4 empty:hidden">
			@FlashBox(t.Flash)
			@ErrorBox(t.Err)
			if t.Stale {
				@ErrorBox("Menampilkan data terakhir; status runtime tidak dapat diverifikasi sehingga ditandai Unknown.")
			}
		</div>
		if len(t.Rows) == 0 {
			@emptyOrNoMatch(t.Total, t.Err != "", "Belum ada akun", "Buat akun C2S pertama untuk remote access.")
		} else {
			<div class="overflow-x-auto pb-1" tabindex="0" aria-label="Tabel dapat digeser horizontal">
				<table class="min-w-full text-sm">
					<thead class="bg-[#E9ECEF]">
						<tr>
							@th("Username")
							@th("Jaringan Diizinkan")
							@th("Admin")
							@th("Runtime")
							@th("Sesi")
							@th("Virtual IP")
							@th("Aksi")
						</tr>
					</thead>
					<tbody>
						for _, u := range t.Rows {
							<tr class="border-t border-[#DEE2E6] hover:bg-[#F8F9FA]">
								<td class="whitespace-nowrap px-3 py-3">
									<span class="flex items-center gap-2 font-semibold text-[#2F6BC4]">
										@Dot(u.RuntimeLabel())
										{ u.Username }
									</span>
									<span class="text-xs text-[#6C757D]">ID { itoa(u.ID) } · <span class="rounded bg-[#E8EEF9] px-2 py-0.5 font-semibold text-[#2F6BC4]">{ u.TrafficLabel() }</span></span>
								</td>
								<td class="px-3 py-3 font-mono">{ model.Join(u.AllowedCIDRs) }</td>
								<td class="px-3 py-3">
									@Badge(u.AdminLabel())
								</td>
								<td class="px-3 py-3">
									@Badge(u.RuntimeLabel())
								</td>
								<td class="px-3 py-3">
									<div class="flex items-center gap-3">
										<span>{ u.SessionLabel() }</span>
										@rowBtn("Detail", "get", idURL("/akun", u.ID, "/sesi"), "#modal", false)
									</div>
								</td>
								<td class="px-3 py-3 font-mono">{ model.Join(u.VirtualIPs) }</td>
								<td class="px-3 py-3">
									@accountActions(u)
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
}

templ UserSessions(u model.User, errMsg string) {
	@Modal("Detail Sesi") {
		@ErrorBox(errMsg)
		if errMsg == "" {
			<p class="mb-4 text-sm font-semibold">{ u.Username } · ID { itoa(u.ID) } · { u.RuntimeLabel() } · Sesi { u.SessionLabel() }</p>
			if len(u.Sessions) == 0 {
				<p class="text-sm text-[#6C757D]">Tidak ada sesi aktif.</p>
			}
			<div class="max-h-96 space-y-3 overflow-y-auto">
				for _, s := range u.Sessions {
					<div class="rounded-lg bg-[#F8F9FA] p-3 font-mono text-xs break-words">
						<div>IKE #{ s.IKEID } · { s.IKEState }</div>
						<div>dari { s.RemoteAddress }</div>
						<div>VIP { model.Join(s.VirtualIPs) }</div>
						for _, c := range s.Children {
							<div class="mt-2">CHILD #{ c.ChildID } · { c.State } · in { model.Bytes(c.BytesIn) } · out { model.Bytes(c.BytesOut) }</div>
						}
					</div>
				}
			</div>
		}
		<div class="mt-5 flex justify-end border-t border-[#DEE2E6] pt-4">
			<button type="button" data-modal-close class="rounded-full border border-[#CED4DA] px-5 py-2 text-sm font-semibold hover:bg-[#F8F9FA]">Tutup</button>
		</div>
	}
}

templ UserForm(f Form) {
	@Modal(ternary(f.Edit(), "Ubah Akun", "Buat Akun")) {
		<form
			if f.Edit() {
				hx-put={ idURL("/akun", f.ID, "") }
			} else {
				hx-post="/akun"
			}
			hx-target="#modal"
			class="space-y-4"
		>
			@ErrorBox(f.Err)
			@field("Username", "username", f.V("username"), "text", f.E("username"), "", true)
			if !f.Edit() {
				@field("Password", "password", "", "password", f.E("password"), "Password baru (8-128 karakter), tidak pernah ditampilkan lagi", true)
			} else {
				@field("Password", "password", "", "password", f.E("password"), "Kosongkan untuk mempertahankan password lama", false)
			}
			<label class="block text-sm font-semibold">
				Allowed CIDRs
				<textarea name="allowed_cidrs" rows="3" placeholder="10.10.7.0/24" class={ inputClass(f.E("allowed_cidrs")) + " font-mono" }>{ f.V("allowed_cidrs") }</textarea>
				<span class="mt-1 block text-xs font-normal text-[#6C757D]">Satu CIDR per baris atau dipisah koma. Kosongkan untuk memakai jaringan LAN default backend.</span>
				if f.E("allowed_cidrs") != "" {
					<span class="mt-1 block text-xs font-normal text-[#B3261E]">{ f.E("allowed_cidrs") }</span>
				}
			</label>
			@trafficMode(f)
			@maxSessions(f)
			@enabledBox(f.Enabled)
			@formFooter(ternary(f.Edit(), "Simpan", "Buat"))
		</form>
	}
}

templ maxSessions(f Form) {
	<label class="block text-sm font-semibold">
		Maks. koneksi bersamaan
		<select name="max_sessions" class={ inputClass(f.E("max_sessions")) }>
			for _, n := range []string{"1", "2", "3"} {
				<option value={ n } selected?={ maxSessionsValue(f) == n }>{ n }</option>
			}
		</select>
		<span class="mt-1 block text-xs font-normal text-[#6C757D]">Jumlah perangkat yang boleh terhubung bersamaan dengan akun ini (1–3, default 3).</span>
		if f.E("max_sessions") != "" {
			<span class="mt-1 block text-xs font-normal text-[#B3261E]">{ f.E("max_sessions") }</span>
		}
	</label>
}

templ trafficMode(f Form) {
	<fieldset class="space-y-2 rounded-lg border border-[#DEE2E6] p-3">
		<legend class="px-1 text-sm font-semibold">Mode trafik</legend>
		<select name="traffic_mode" aria-label="Mode trafik" class={ inputClass(f.E("traffic_mode")) }>
			<option value="split" selected?={ f.V("traffic_mode") != "full" }>Split tunnel (default)</option>
			<option value="full" selected?={ f.V("traffic_mode") == "full" }>Full tunnel</option>
		</select>
		<p class="text-xs text-[#6C757D]">Split: hanya jaringan diizinkan lewat VPN (default). Full: semua internet lewat server; akses LAN tetap dibatasi allowed CIDRs. Unduh ulang profil / Setup Windows lalu sambungkan ulang setelah mengubah mode.</p>
		if f.E("traffic_mode") != "" {
			<p class="text-xs text-[#B3261E]">{ f.E("traffic_mode") }</p>
		}
	</fieldset>
}

// rowActions is the shared row action menu for /akun and /koneksi: a plain
// vertical three-dot toggle; options live in a manual popover that app.js
// opens on click only and closes on outside click, Escape or selection.
templ rowActions(menuID, name string) {
	<div data-row-actions>
		<button type="button" data-actions-toggle aria-label={ "Aksi untuk " + name } aria-haspopup="menu" aria-expanded="false" aria-controls={ menuID } class="kebab-button">
			<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><circle cx="12" cy="5" r="1.8"></circle><circle cx="12" cy="12" r="1.8"></circle><circle cx="12" cy="19" r="1.8"></circle></svg>
		</button>
		<div id={ menuID } class="action-menu" role="menu" aria-label={ "Aksi " + name } popover="manual">
			{ children... }
		</div>
	</div>
}

templ accountActions(u model.User) {
	@rowActions("account-menu-"+itoa(u.ID), u.Username) {
		<button type="button" role="menuitem" hx-get={ idURL("/akun", u.ID, "/ubah") } hx-target="#modal">Ubah</button>
		<button type="button" role="menuitem" hx-get={ idURL("/akun", u.ID, "/password") } hx-target="#modal">Password</button>
		<a role="menuitem" href={ templ.URL(idURL("/unduh/akun", u.ID, "/profil.json")) } download title="Profil berisi kredensial; simpan dengan aman">Profil VPN (.json)</a>
		<a role="menuitem" href={ templ.URL(idURL("/unduh/akun", u.ID, "/windows.ps1")) } download>Setup-Client(windows).ps1</a>
		<a role="menuitem" href={ templ.URL(idURL("/unduh/akun", u.ID, "/vpnaas-ca.crt")) } download>Download Sertifikat (.crt)</a>
		<button type="button" role="menuitem" class="menu-danger" hx-get={ idURL("/akun", u.ID, "/hapus") } hx-target="#modal">Hapus</button>
	}
}

// hubActions: hub rows reuse the click-only action menu; per-site connect,
// disconnect (with confirm) and configure/download items.
templ hubActions(c ConnRow) {
	@rowActions("connection-menu-"+itoa(c.ID), c.Name) {
		<button type="button" role="menuitem" hx-get={ idURL("/koneksi", c.ID, "/ubah") } hx-target="#modal">Ubah</button>
		for _, k := range []string{"a", "b"} {
			<hr role="separator"/>
			<button type="button" role="menuitem" hx-get={ siteURL(c.ID, k, "configure") } hx-target="#modal" title="Langkah setup gateway site">{ "Configure " + siteLabel(k) }</button>
			<a role="menuitem" href={ templ.URL(siteDownload(c.ID, k, "setup.sh")) } download title="Berisi PSK; simpan dengan aman">{ "Download script " + siteLabel(k) + " (.sh)" }</a>
			<a role="menuitem" href={ templ.URL(siteDownload(c.ID, k, "hub.conf")) } download title="Berisi PSK; simpan dengan aman">{ "Download config " + siteLabel(k) + " (.conf)" }</a>
		}
		<hr role="separator"/>
		for _, k := range []string{"a", "b"} {
			<button type="button" role="menuitem" hx-post={ siteURL(c.ID, k, "connect") } hx-target="#conn-table" hx-swap="outerHTML" title="Mulai tunnel hub ke site ini">{ "Connect " + siteLabel(k) }</button>
			<button type="button" role="menuitem" hx-get={ siteURL(c.ID, k, "disconnect") } hx-target="#modal" title="Putus tunnel site ini; bisa connect ulang">{ "Disconnect " + siteLabel(k) }</button>
		}
		<button type="button" role="menuitem" class="menu-danger" hx-get={ idURL("/koneksi", c.ID, "/hapus") } hx-target="#modal">Hapus</button>
	}
}

templ connectionActions(c ConnRow) {
	@rowActions("connection-menu-"+itoa(c.ID), c.Name) {
		<button type="button" role="menuitem" hx-get={ idURL("/koneksi", c.ID, "/ubah") } hx-target="#modal">Ubah</button>
		<button type="button" role="menuitem" hx-post={ idURL("/koneksi", c.ID, "/initiate") } hx-target="#conn-table" hx-swap="outerHTML" title="Mulai tunnel ke peer sekarang">Connect</button>
		<button type="button" role="menuitem" hx-get={ idURL("/koneksi", c.ID, "/terminate") } hx-target="#modal" title="Putus tunnel; bisa connect ulang kapan saja">Disconnect</button>
		<button type="button" role="menuitem" class="menu-danger" hx-get={ idURL("/koneksi", c.ID, "/hapus") } hx-target="#modal">Hapus</button>
	}
}

templ PasswordForm(id int, username, errMsg, fieldErr string) {
	@Modal("Reset Password") {
		<form hx-put={ idURL("/akun", id, "/password") } hx-target="#modal" class="space-y-4">
			@ErrorBox(errMsg)
			<input type="hidden" name="username" value={ username }/>
			<p class="text-sm text-[#495057]">Atur password baru untuk <span class="font-mono font-semibold">{ username }</span>. Sesi aktif akun ini akan diputus oleh backend. Password tidak pernah ditampilkan kembali.</p>
			@field("Password baru", "password", "", "password", fieldErr, "8-128 karakter", true)
			@formFooter("Reset Password")
		</form>
	}
}

// ---------- Firewall Rules (/kebijakan) ----------
templ PoliciesPage(t PolicyTable) {
	@PageHeader("Firewall Rules", "Allow rule tambahan untuk traffic yang diforward antar jaringan (S2S/LAN). Default: deny. Akses user C2S tetap diatur dari Allowed CIDRs akun.", PrimaryButton("Buat Rule", "/kebijakan/baru"))
	@VPNTabs("kebijakan")
	@PoliciesTable(t)
}

templ PoliciesTable(t PolicyTable) {
	<section id="policies-table" class="rounded-xl border border-[#DEE2E6]" hx-get="/kebijakan/tabel" hx-trigger="vpnaas:changed from:body" hx-swap="outerHTML" hx-include="this" hx-disinherit="*">
		@tableHead(len(t.Rows), t.Total, "/kebijakan/tabel", "#policies-table", t.Query, "Cari rule…")
		<div class="px-5 pt-4 empty:hidden">
			@FlashBox(t.Flash)
			@ErrorBox(t.Err)
		</div>
		if len(t.Rows) == 0 {
			@emptyOrNoMatch(t.Total, t.Err != "", "Belum ada firewall rule", "Buat allow rule untuk mengizinkan traffic antar CIDR.")
		} else {
			<div class="overflow-x-auto pb-1" tabindex="0" aria-label="Tabel dapat digeser horizontal">
				<table class="min-w-full text-sm">
					<thead class="bg-[#E9ECEF]">
						<tr>
							@th("Nama")
							@th("Source")
							@th("Destination")
							@th("Protokol")
							@th("Status")
							@th("Aksi")
						</tr>
					</thead>
					<tbody>
						for _, p := range t.Rows {
							<tr class="border-t border-[#DEE2E6] hover:bg-[#F8F9FA]">
								<td class="whitespace-nowrap px-3 py-3 font-semibold text-[#2F6BC4]">{ p.Name }</td>
								<td class="px-3 py-3 font-mono">{ p.SourceCIDR }</td>
								<td class="px-3 py-3 font-mono">{ p.DestinationCIDR }</td>
								<td class="px-3 py-3">{ upper(p.Protocol) }</td>
								<td class="px-3 py-3">
									@Badge(p.AdminLabel())
								</td>
								<td class="px-3 py-3">
									<div class="flex min-w-[240px] max-w-[320px] flex-wrap gap-1.5">
										@rowBtn("Ubah", "get", idURL("/kebijakan", p.ID, "/ubah"), "#modal", false)
										@rowBtn("Hapus", "get", idURL("/kebijakan", p.ID, "/hapus"), "#modal", true)
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
}

templ PolicyForm(f Form) {
	@Modal(ternary(f.Edit(), "Ubah Firewall Rule", "Buat Firewall Rule")) {
		<form
			if f.Edit() {
				hx-put={ idURL("/kebijakan", f.ID, "") }
			} else {
				hx-post="/kebijakan"
			}
			hx-target="#modal"
			class="space-y-4"
		>
			@ErrorBox(f.Err)
			@field("Nama rule", "name", f.V("name"), "text", f.E("name"), "", true)
			@field("Source CIDR", "source_cidr", f.V("source_cidr"), "text", f.E("source_cidr"), "Jaringan asal traffic, mis. 10.1.0.0/24 (LAN site lawan)", true)
			@field("Destination CIDR", "destination_cidr", f.V("destination_cidr"), "text", f.E("destination_cidr"), "Jaringan tujuan traffic, mis. 10.10.7.0/24 (LAN server ini). Hanya arah source → destination yang diizinkan.", true)
			<label class="block text-sm font-semibold">
				Protokol
				<select name="protocol" class={ inputClass(f.E("protocol")) }>
					for _, p := range []string{"all", "tcp", "udp", "icmp"} {
						<option value={ p } selected?={ f.V("protocol") == p }>{ upper(p) }</option>
					}
				</select>
				if f.E("protocol") != "" {
					<span class="mt-1 block text-xs font-normal text-[#B3261E]">{ f.E("protocol") }</span>
				}
			</label>
			@enabledBox(f.Enabled)
			@formFooter(ternary(f.Edit(), "Simpan", "Buat"))
		</form>
	}
}
